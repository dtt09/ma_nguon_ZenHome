rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm tiện ích: Kiểm tra xem user đã đăng nhập chưa
    function isSignedIn() {
      return request.auth != null;
    }

    // Kiểm tra người dùng có phải là chủ sở hữu của tài khoản userId (hỗ trợ cả UID và Username)
    function isParentOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
      );
    }

    // Kiểm tra có phải chủ sở hữu tài khoản hoặc UID khớp
    function isUserOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      );
    }

    // Kiểm tra xem thành viên có đang bị vô hiệu hóa / khóa quyền không (SEC-FIX: Lọc mảng disabledMembers và disabledUids)
    function isMemberDisabled(userData) {
      return userData != null && (
        (userData.disabledMembers is list && (
          userData.disabledMembers.hasAny([request.auth.token.email, request.auth.uid]) ||
          (request.auth.token.email != null && userData.disabledMembers.hasAny([request.auth.token.email.split('@')[0]]))
        )) ||
        (userData.disabledUids is list && userData.disabledUids.hasAny([request.auth.uid]))
      );
    }

    // Kiểm tra xem người dùng hiện tại có nằm trong danh sách thành viên đã chấp thuận chia sẻ không (hỗ trợ cả UID và Username)
    function isSharedMember(userData) {
      return isSignedIn() && userData != null &&
        !isMemberDisabled(userData) &&
        (
          (userData.sharedWith is list && (
            userData.sharedWith.hasAny([request.auth.token.email, request.auth.uid]) ||
            (request.auth.token.email != null && userData.sharedWith.hasAny([request.auth.token.email.split('@')[0]]))
          )) ||
          (userData.sharedUids is list && userData.sharedUids.hasAny([request.auth.uid]))
        );
    }

    // Kiểm tra xem người dùng có được Chủ nhà gửi lời mời hợp lệ qua sentInvitations không
    function isInvitedMember(userData) {
      return isSignedIn() && userData != null &&
        userData.sentInvitations is list && (
          userData.sentInvitations.hasAny([request.auth.uid]) ||
          (request.auth.token.email != null && (
            userData.sentInvitations.hasAny([request.auth.token.email, request.auth.token.email.split('@')[0]])
          ))
        );
    }

    // Hồ sơ người dùng
    match /users/{userId} {
      // 1. Cho phép đọc thông tin chi tiết (get) từng tài khoản khi biết trước document ID:
      // Phục vụ kiểm tra username trùng lặp khi đăng ký, tra cứu email để đăng nhập,
      // và cho phép chính chủ / thành viên chia sẻ truy cập hồ sơ.
      allow get: if true;

      // 2. Chặn việc query / list toàn bộ collection 'users':
      // CHỈ cho phép khi người dùng đã đăng nhập và là chính chủ hoặc thành viên chia sẻ của document đó.
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.uid ||
        isSharedMember(resource.data)
      );

      // 3. Cho phép tạo tài khoản mới khi đã xác thực Firebase Auth (Google, SĐT, Email) và UID khớp
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;

      // 4. Cho phép cập nhật thông tin:
      allow update: if isSignedIn() && (
        // Chính chủ cập nhật
        request.auth.uid == resource.data.uid ||
        request.auth.uid == userId ||
        // Người khác gửi lời mời tham gia nhà: chỉ được phép thêm vào pendingInvitations
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingInvitations']) ||
        // Người nhận lời mời: CHỈ cho phép khi thực sự có trong sentInvitations của chủ nhà (chống tự cấp quyền trái phép)
        (isInvitedMember(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'sharedUids', 'sentInvitations'])) ||
        // Cho phép thành viên tự rời nhà (xóa mình khỏi sharedWith, sharedUids, automationEditors, disabledMembers, disabledUids)
        (isSharedMember(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'sharedWith', 'sharedUids', 'automationEditors', 'disabledMembers', 'disabledUids'
         ])) ||
        // Thành viên phụ (Shared Member) cập nhật các cài đặt không can thiệp vào bảo mật nhạy cảm
        (isSharedMember(resource.data) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'adminPass', 'macAddress', 'devices', 'sharedWith', 'sharedUids', 'memberRoles',
           'disabledMembers', 'disabledUids', 'memberDevicePermissions', 'uid', 'email', 'phone'
         ]))
      );

      // 5. Xóa tài khoản: Chỉ chính chủ
      allow delete: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.uid == request.auth.uid)
      );

      // Subcollections (history, sessions, alerts, timers, scenes, schedules):
      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (
          isParentOwner(userId) ||
          // Chặn thành viên phụ đọc sessions để chống rò rỉ tọa độ GPS và FCM Push Token của Chủ nhà
          (subcollection != 'sessions' &&
           exists(/databases/$(database)/documents/users/$(userId)) &&
           isSharedMember(get(/databases/$(database)/documents/users/$(userId)).data))
        );
        allow write: if isSignedIn() && (
          isParentOwner(userId) ||
          // Thành viên phụ hợp lệ được ghi nhận vào history, alerts, timers, schedules, scenes
          (exists(/databases/$(database)/documents/users/$(userId)) &&
           isSharedMember(get(/databases/$(database)/documents/users/$(userId)).data) &&
           subcollection in ['history', 'alerts', 'timers', 'schedules', 'scenes']) ||
          // Cho phép gửi thông báo mời vào subcollection alerts của người nhận
          (subcollection == 'alerts' && request.resource.data.type == 'new_invite')
        );
      }
    }

    // Bảng tra cứu SĐT nhanh (Phone Lookup Index):
    // Cho phép đọc ĐÍCH DANH khi biết số điện thoại (get) để phục vụ đăng nhập SĐT + Mật khẩu và kiểm tra trùng lặp.
    // TUYỆT ĐỐI CHẶN duyệt quét/cào dữ liệu (list: false) để chống lộ danh bạ người dùng.
    match /phone_lookup/{phoneNumber} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Cấu hình hệ thống (app_version, server_config): Chỉ đọc công khai, chỉ Backend Admin được ghi
    match /system_config/{configId} {
      allow read: if true;
      allow write: if false; // Chỉ Firebase Admin SDK trên Server mới được sửa
    }

    // Báo cáo sự cố và Nhật ký lỗi Crashlytics: Cho phép ghi nhận từ ứng dụng di động, cấm đọc tùy tiện (chỉ Server Admin SDK đọc)
    match /crash_logs/{logId} {
      allow create: if true;
      allow read: if false; // Chỉ Firebase Admin SDK trên Server mới được đọc/xử lý
      allow update, delete: if false; // Chỉ Server Admin mới được xóa/sửa
    }

    // Báo cáo lỗi từ người dùng: Chỉ cho phép người tạo đọc lại báo cáo của chính mình
    match /bug_reports/{reportId} {
      allow create: if true;
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
      allow update, delete: if false; // Chỉ Server Admin mới được xóa/sửa
    }

    // Yêu cầu xóa tài khoản: User chỉ được tạo request cho chính mình, không được sửa/xóa/đọc trộm của người khác
    match /delete_requests/{userId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if false; // Chỉ Backend Worker xử lý
    }

    // Yêu cầu giải phóng định danh / email ảo: Chỉ user sở hữu UID mới được gửi
    match /unlink_requests/{userId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if false; // Chỉ Backend Worker xử lý
    }

    // Server-only collections: Khóa hoàn toàn khỏi client SDK di động
    match /server_schedules/{docId} {
      allow read, write: if false;
    }
    match /server_timers/{docId} {
      allow read, write: if false;
    }
    match /system_backups/{docId} {
      allow read, write: if false;
    }
  }
}
