    bool isDark = Theme.of(context).brightness == Brightness.dark;

    return Builder(
      builder: (context) {
        String currentLang = ref.watch(localeNotifierProvider).languageCode;
        return Scaffold(
          backgroundColor: isDark
              ? const Color(0xFF121212)
              : const Color(0xFFF5F7FA),
          body: Stack(
            children: [
              // 1. Base Layer
              SafeArea(
                child: Stack(
                  children: [
                    Column(
                      children: [
                        const SizedBox(height: 40),
                        _buildHeader(context, false), // Base Header (Blue)

                        Expanded(
                          child: Center(
                            child: SingleChildScrollView(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 30,
                              ),
                              child: Column(
                                mainAxisAlignment: MainAxisAlignment.center,
                                children: [
                                  const SizedBox(height: 20),
                                  if (!_isEmailChecked)
                                    TextField(
                                      controller: _emailController,
                                      keyboardType: TextInputType.emailAddress,
                                      decoration: InputDecoration(
                                        filled: true,
                                        fillColor: isDark
                                            ? const Color(0xFF1E1E1E)
                                            : Colors.white,
                                        labelText:
                                            context.tr('email_label') ??
                                            'Email tài khoản',
                                        prefixIcon: const Icon(Icons.person),
                                        border: OutlineInputBorder(
                                          borderRadius: BorderRadius.circular(
                                            15,
                                          ),
                                        ),
                                      ),
                                    ),

                                  if (_isEmailChecked)
                                    TextField(
                                      controller: _passController,
                                      obscureText: _obscurePass,
                                      autofocus: true,
                                      decoration: InputDecoration(
                                        filled: true,
                                        fillColor: isDark
                                            ? const Color(0xFF1E1E1E)
                                            : Colors.white,
                                        labelText:
                                            context.tr('password_label') ??
                                            'Mật khẩu',
                                        prefixIcon: const Icon(Icons.lock),
                                        suffixIcon: IconButton(
                                          icon: Icon(
                                            _obscurePass
                                                ? Icons.visibility_off
                                                : Icons.visibility,
                                          ),
                                          onPressed: () => setState(
                                            () => _obscurePass = !_obscurePass,
                                          ),
                                        ),
                                        border: OutlineInputBorder(
                                          borderRadius: BorderRadius.circular(
                                            15,
                                          ),
                                        ),
                                      ),
                                    ),

                                  const SizedBox(height: 10),

                                  if (_isEmailChecked)
                                    Align(
                                      alignment: Alignment.centerRight,
                                      child: TextButton(
                                        onPressed: () {
                                          Navigator.push(
                                            context,
                                            MaterialPageRoute(
                                              builder: (context) =>
                                                  const ForgotPasswordScreen(),
                                            ),
                                          );
                                        },
                                        child: Text(
                                          context.tr('forgot_password') ??
                                              'Quên mật khẩu?',
                                          style: const TextStyle(
                                            fontWeight: FontWeight.bold,
                                          ),
                                        ),
                                      ),
                                    ),

                                  const SizedBox(height: 15),
                                  SizedBox(
                                    width: double.infinity,
                                    height: 55,
                                    child: ElevatedButton(
                                      style: ElevatedButton.styleFrom(
                                        backgroundColor: const Color(
                                          0xFF2A3A7C,
                                        ),
                                        foregroundColor: Colors.white,
                                        shape: RoundedRectangleBorder(
                                          borderRadius: BorderRadius.circular(
                                            15,
                                          ),
                                        ),
                                      ),
                                      onPressed: _isLoading || _isCheckingEmail
                                          ? null
                                          : (_isEmailChecked
                                                ? _handleLogin
                                                : _checkEmail),
                                      child: _isLoading || _isCheckingEmail
                                          ? const CircularProgressIndicator(
                                              color: Colors.white,
                                            )
                                          : Text(
                                              _isEmailChecked
                                                  ? (context.tr('btn_login') ??
                                                        'Đăng nhập')
                                                  : (context.tr(
                                                          'btn_continue',
                                                        ) ??
                                                        'Tiếp tục'),
                                              style: const TextStyle(
                                                fontSize: 18,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                    ),
                                  ),

                                  if (_isEmailChecked)
                                    TextButton(
                                      onPressed: () => setState(() {
                                        _isEmailChecked = false;
                                        _passController.clear();
                                      }),
                                      child: Text(
                                        context.tr('use_other_account'),
                                        style: TextStyle(
                                          color: Colors.grey.shade600,
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                    ),

                                  if (!_isEmailChecked) ...[
                                    const SizedBox(height: 25),
                                    Row(
                                      children: [
                                        Expanded(
                                          child: Divider(
                                            color: Colors.grey.shade400,
                                          ),
                                        ),
                                        Padding(
                                          padding: const EdgeInsets.symmetric(
                                            horizontal: 10,
                                          ),
                                          child: Text(
                                            context.tr('or_divider') ?? 'HOẶC',
                                            style: TextStyle(
                                              color: Colors.grey.shade500,
                                              fontWeight: FontWeight.bold,
                                            ),
                                          ),
                                        ),
                                        Expanded(
                                          child: Divider(
                                            color: Colors.grey.shade400,
                                          ),
                                        ),
                                      ],
                                    ),
                                    const SizedBox(height: 25),
                                    SizedBox(
                                      width: double.infinity,
                                      height: 55,
                                      child: OutlinedButton.icon(
                                        style: OutlinedButton.styleFrom(
                                          foregroundColor: isDark
                                              ? Colors.white
                                              : Colors.black87,
                                          side: BorderSide(
                                            color: Colors.grey.shade400,
                                          ),
                                          shape: RoundedRectangleBorder(
                                            borderRadius: BorderRadius.circular(
                                              15,
                                            ),
                                          ),
                                        ),
                                        icon: _isGoogleLoading
                                            ? const SizedBox(
                                                width: 20,
                                                height: 20,
                                                child:
                                                    CircularProgressIndicator(
                                                      strokeWidth: 2,
                                                    ),
                                              )
                                            : const Icon(
                                                Icons.g_mobiledata,
                                                size: 30,
                                                color: Colors.red,
                                              ),
                                        label: Text(
                                          context.tr('continue_with_google') ??
                                              'Tiếp tục với Google',
                                          style: const TextStyle(
                                            fontSize: 16,
                                            fontWeight: FontWeight.bold,
                                          ),
                                        ),
                                        onPressed: _isGoogleLoading
                                            ? null
                                            : _handleGoogleLogin,
                                      ),
                                    ),
                                    const SizedBox(height: 25),
                                    Row(
                                      mainAxisAlignment:
                                          MainAxisAlignment.center,
                                      children: [
                                        Text(
                                          context.tr('no_account') ??
                                              'Chưa có tài khoản?',
                                          style: TextStyle(
                                            color: Colors.grey.shade600,
                                          ),
                                        ),
                                        TextButton(
                                          onPressed: () => Navigator.push(
                                            context,
                                            MaterialPageRoute(
                                              builder: (context) =>
                                                  const RegisterScreen(),
                                            ),
                                          ),
                                          child: Text(
                                            context.tr('register') ?? 'Đăng ký',
                                            style: const TextStyle(
                                              fontWeight: FontWeight.bold,
                                            ),
                                          ),
                                        ),
                                      ],
                                    ),
                                  ],
                                ],
                              ),
                            ),
                          ),
                        ),
                      ],
                    ),
                    Positioned(
                      top: 20,
                      right: 20,
                      child: InkWell(
                        onTap: () async {
                          String newLang = currentLang == 'vi' ? 'en' : 'vi';
                          ref
                              .read(localeNotifierProvider.notifier)
                              .setLocale(newLang);

                          final prefs = await SharedPreferences.getInstance();
                          await prefs.setString('app_lang', newLang);
                        },
                        borderRadius: BorderRadius.circular(20),
                        child: Container(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 12,
                            vertical: 8,
                          ),
                          decoration: BoxDecoration(
                            color: isDark
                                ? Colors.white12
                                : Colors.black.withOpacity(0.05),
                            borderRadius: BorderRadius.circular(20),
                            border: Border.all(
                              color: Colors.grey.withOpacity(0.2),
                            ),
                          ),
                          child: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Icon(
                                Icons.language,
                                size: 18,
                                color: isDark
                                    ? Colors.white70
                                    : const Color(0xFF2A3A7C),
                              ),
                              const SizedBox(width: 6),
                              Text(
                                currentLang == 'vi' ? 'VN' : 'EN',
                                style: TextStyle(
                                  fontWeight: FontWeight.bold,
                                  color: isDark
                                      ? Colors.white70
                                      : const Color(0xFF2A3A7C),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ),

              // 2. Wave Layer
              WaveBackground(
                heightPercent: 0.4,
                child: SafeArea(
                  child: Column(
                    children: [
                      const SizedBox(height: 40),
                      _buildHeader(context, true), // Top Header (White)
                    ],
                  ),
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}
