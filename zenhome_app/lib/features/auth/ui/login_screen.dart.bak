class LoginScreen extends ConsumerStatefulWidget {
  const LoginScreen({super.key});

  @override
  ConsumerState<LoginScreen> createState() => _LoginScreenState();
}

class _LoginScreenState extends ConsumerState<LoginScreen> {
  final TextEditingController _emailController = TextEditingController();
  final TextEditingController _passController = TextEditingController();
  bool _obscurePass = true;
  bool _isLoading = false;
  bool _isGoogleLoading = false;
  bool _isEmailChecked = false;
  bool _isCheckingEmail = false;
  String _userAvatarUrl = '';
  String _userName = '';

  void _saveAndNavigate(String email) async {
    List<SmartConfig> myHomes = [];

    try {
      // 1. Tải Nhà của chính mình (nếu có)
      final myDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(email)
          .get();
      if (myDoc.exists) {
        final data = myDoc.data() as Map<String, dynamic>;
        if (data.containsKey('ownerEmail') &&
            data['ownerEmail'].toString().isNotEmpty) {
          // Là cấu trúc cũ, chỉ là thành viên
          String targetEmail = data['ownerEmail'];
          final targetDoc = await FirebaseFirestore.instance
              .collection('users')
              .doc(targetEmail)
              .get();
          if (targetDoc.exists) {
            final targetData = targetDoc.data()!;
            List<DeviceConfig> restoredDevices = [];
            if (targetData['devices'] != null) {
              restoredDevices = (targetData['devices'] as List)
                  .map((e) => DeviceConfig.fromJson(e))
                  .toList();
            }
            String ownerName =
                targetData['displayName'] ?? targetEmail.split('@')[0];
            myHomes.add(
              SmartConfig(
                userId: targetEmail.split('@')[0],
                macAddress: targetData['macAddress'] ?? 'unknown_mac',
                mqttServer: targetData['mqttServer'] ?? 'broker.emqx.io',
                mqttUser: targetData['mqttUser'],
                mqttPass: targetData['mqttPass'],
                devices: restoredDevices,
                role: 'member',
                homeName: '${context.tr('home_of')} $ownerName',
                ownerEmail: targetEmail,
              ),
            );
          }
        } else {
          // Là chủ nhà
          List<DeviceConfig> restoredDevices = [];
          if (data['devices'] != null) {
            restoredDevices = (data['devices'] as List)
                .map((e) => DeviceConfig.fromJson(e))
                .toList();
          }
          myHomes.add(
            SmartConfig(
              userId: email.split('@')[0],
              macAddress: data['macAddress'] ?? 'unknown_mac',
              mqttServer: data['mqttServer'] ?? 'broker.emqx.io',
              mqttUser: data['mqttUser'],
              mqttPass: data['mqttPass'],
              devices: restoredDevices,
              role: 'owner',
              homeName: context.tr('my_home_default'),
              ownerEmail: email,
            ),
          );
        }
      } else {
        // Nếu user mới chưa có document trên Firestore, vẫn tạo nhà mặc định của họ
        myHomes.add(
          SmartConfig(
            userId: email.split('@')[0],
            macAddress: 'unknown_mac',
            mqttServer: 'broker.emqx.io',
            mqttUser: null,
            mqttPass: null,
            devices: [],
            role: 'owner',
            homeName: context.tr('my_home_default'),
            ownerEmail: email,
          ),
        );
      }

      // 2. Tải các Nhà mình được mời (Cấu trúc mới: sharedWith)
      final sharedQuery = await FirebaseFirestore.instance
          .collection('users')
          .where('sharedWith', arrayContains: email)
          .get();
      for (var doc in sharedQuery.docs) {
        String ownerEmail = doc.id;
        // Tránh trùng lặp nếu bị dính cấu trúc cũ
        if (myHomes.any((h) => h.userId == ownerEmail.split('@')[0])) continue;

        final data = doc.data();
        List<DeviceConfig> restoredDevices = [];
        if (data['devices'] != null) {
          restoredDevices = (data['devices'] as List)
              .map((e) => DeviceConfig.fromJson(e))
              .toList();
        }
        String ownerName = data['displayName'] ?? ownerEmail.split('@')[0];
        myHomes.add(
          SmartConfig(
            userId: ownerEmail.split('@')[0],
            macAddress: data['macAddress'] ?? 'unknown_mac',
            mqttServer: data['mqttServer'] ?? 'broker.emqx.io',
            mqttUser: data['mqttUser'],
            mqttPass: data['mqttPass'],
            devices: restoredDevices,
            role: 'member',
            homeName: '${context.tr('home_of')} $ownerName',
            ownerEmail: ownerEmail,
          ),
        );
      }
    } catch (e) {
      print("❌ Lỗi đồng bộ Firebase: $e");
    }

    if (myHomes.isEmpty) {
      myHomes.add(
        SmartConfig(
          userId: email.split('@')[0],
          macAddress: 'unknown_mac',
          devices: [],
          role: 'owner',
          homeName: context.tr('my_home_default'),
        ),
      );
    }

    setAvailableHomes(myHomes);

    // 3. Đăng ký nhận thông báo cho TẤT CẢ các nhà
    final prefs = await SharedPreferences.getInstance();
    String lang = prefs.getString('app_lang') ?? 'en';
    for (var home in myHomes) {
      try {
        await FirebaseMessaging.instance.unsubscribeFromTopic(
          'home_${home.userId}',
        );
        await FirebaseMessaging.instance.unsubscribeFromTopic(
          'home_${home.userId}_vi',
        );
        await FirebaseMessaging.instance.unsubscribeFromTopic(
          'home_${home.userId}_en',
        );
        await FirebaseMessaging.instance.subscribeToTopic(
          'home_${home.userId}_$lang',
        );
        print("🔔 Đã đăng ký kênh thông báo: home_${home.userId}_$lang");
      } catch (e) {
        print("❌ Lỗi đăng ký thông báo cho ${home.userId}: $e");
      }
    }

    if (mounted) {
      showFloatingToast(
        context,
        context.tr('toast_success'),
        context.tr('msg_sync_success') ?? 'Đã đồng bộ dữ liệu nhà!',
      );
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (context) => const MainLayout()),
      );
    }
  }

  void _checkEmail() async {
    final String email = _emailController.text.trim();
    if (email.isEmpty) {
      showFloatingToast(
        context,
        context.tr('error'),
        context.tr('err_empty_field') ?? 'Vui lòng nhập Email!',
        isError: true,
      );
      return;
    }

    if (!email.toLowerCase().endsWith('@gmail.com')) {
      showFloatingToast(
        context,
        context.tr('error'),
        'Email phải có định dạng @gmail.com!',
        isError: true,
      );
      return;
    }

    LoadingOverlay.show(context);
    try {
      // 1. Kiểm tra qua Mailboxlayer xem email có tồn tại thật trên Google/SMTP không
      final String email = _emailController.text.trim();
      final url = Uri.parse(
        'http://apilayer.net/api/check?access_key=d53dae58e417d47fda0ce7f3af6fffa1&email=$email',
      );
      final response = await http.get(url);
      if (response.statusCode == 200) {
        final data = json.decode(response.body);
        if (data['format_valid'] == true && data['mx_found'] == false) {
          LoadingOverlay.hide();
          showFloatingToast(
            context,
            context.tr('error'),
            'Email này không tồn tại thật trên máy chủ (Google, Yahoo...). Vui lòng nhập email thật!',
            isError: true,
          );
          return;
        }
      }

      // 2. Kiểm tra xem đã có tài khoản trên Firebase chưa (Dùng Firestore)
      final doc = await FirebaseFirestore.instance
          .collection('users')
          .doc(email)
          .get();

      LoadingOverlay.hide();

      if (doc.exists) {
        setState(() {
          _isEmailChecked = true;
        });
      } else {
        // Show dialog asking if they want to register
        showDialog(
          context: context,
          builder: (ctx) {
            bool isDark = Theme.of(context).brightness == Brightness.dark;
            return AlertDialog(
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(20),
              ),
              backgroundColor: isDark ? const Color(0xFF1E1E1E) : Colors.white,
              title: Text(
                context.tr('no_account') ?? 'Chưa có tài khoản?',
                style: TextStyle(color: isDark ? Colors.white : Colors.black),
              ),
              content: Text(
                context.tr('register_prompt') ??
                    'Email này dường như chưa được đăng ký. Bạn có muốn tạo tài khoản mới không?',
                style: TextStyle(
                  color: isDark ? Colors.white70 : Colors.black87,
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(ctx),
                  child: Text(
                    context.tr('btn_cancel'),
                    style: const TextStyle(color: Colors.grey),
                  ),
                ),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF2A3A7C),
                    foregroundColor: Colors.white,
                  ),
                  onPressed: () {
                    Navigator.pop(ctx);
                    Navigator.push(
                      context,
                      MaterialPageRoute(
                        builder: (context) => const RegisterScreen(),
                      ),
                    );
                  },
                  child: Text(context.tr('register') ?? 'Đăng ký'),
                ),
              ],
            );
          },
        );
      }
    } catch (e) {
      LoadingOverlay.hide();
      setState(() {
        _isEmailChecked = true;
      });
    }
  }

  void _handleLogin() async {
    final String email = _emailController.text.trim();
    if (email.isEmpty || _passController.text.trim().isEmpty) {
      showFloatingToast(
        context,
        context.tr('error'),
        context.tr('err_empty_field') ?? 'Vui lòng nhập đầy đủ thông tin!',
        isError: true,
      );
      return;
    }

    if (!email.toLowerCase().endsWith('@gmail.com')) {
      showFloatingToast(
        context,
        context.tr('error'),
        'Email phải có định dạng @gmail.com!',
        isError: true,
      );
      return;
    }

    LoadingOverlay.show(context);
    try {
      await FirebaseAuth.instance.signInWithEmailAndPassword(
        email: email,
        password: _passController.text.trim(),
      );

      final doc = await FirebaseFirestore.instance
          .collection('users')
          .doc(email)
          .get();
      final data = doc.data();
      bool isVerified = data != null && data.containsKey('is_email_verified')
          ? data['is_email_verified']
          : false;

      LoadingOverlay.hide();

      if (!isVerified) {
        Navigator.push(
          context,
          MaterialPageRoute(
            builder: (context) => OtpVerificationScreen(email: email),
          ),
        );
      } else {
        _saveAndNavigate(email);
      }
    } on FirebaseAuthException {
      LoadingOverlay.hide();
      showFloatingToast(
        context,
        context.tr('error'),
        context.tr('err_invalid_login') ??
            'Tài khoản hoặc mật khẩu không chính xác!',
        isError: true,
      );
    } catch (e) {
      LoadingOverlay.hide();
      showFloatingToast(
        context,
        context.tr('error'),
        'Đã xảy ra lỗi: $e',
        isError: true,
      );
    }
  }

  void _handleGoogleLogin() async {
    setState(() => _isGoogleLoading = true);
    try {
      final GoogleSignIn googleSignIn = GoogleSignIn(
        serverClientId: dotenv.env['GOOGLE_CLIENT_ID']!, // Lấy từ file .env
      );

      final GoogleSignInAccount? googleUser = await googleSignIn.signIn();

      if (googleUser == null) {
        setState(() => _isGoogleLoading = false);
        return;
      }

      final GoogleSignInAuthentication googleAuth =
          await googleUser.authentication;
      final AuthCredential credential = GoogleAuthProvider.credential(
        accessToken: googleAuth.accessToken,
        idToken: googleAuth.idToken,
      );

      final UserCredential userCred = await FirebaseAuth.instance
          .signInWithCredential(credential);
      final String userEmail = userCred.user?.email ?? googleUser.email;

      if (userCred.additionalUserInfo?.isNewUser == true) {
        if (mounted) _showSetPasswordBottomSheet(userEmail, userCred.user!);
      } else {
        if (mounted) _saveAndNavigate(userEmail);
      }
    } catch (e) {
      print("🚨 LỖI GOOGLE SIGN-IN: $e");
      showFloatingToast(
        context,
        context.tr('error'),
        '${context.tr('error')}: $e',
        isError: true,
      );
    } finally {
      if (mounted) setState(() => _isGoogleLoading = false);
    }
  }

  void _showSetPasswordBottomSheet(String googleEmail, User firebaseUser) {
    final TextEditingController newPassCtrl = TextEditingController();
    final TextEditingController confirmPassCtrl = TextEditingController();
    bool obs1 = true;
    bool obs2 = true;

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      isDismissible: false,
      enableDrag: false,
      backgroundColor: Colors.transparent,
      builder: (ctx) {
        return StatefulBuilder(
          builder: (BuildContext ctx, StateSetter setModalState) {
            bool isDark = Theme.of(context).brightness == Brightness.dark;
            return Container(
              height: MediaQuery.of(context).size.height * 0.65,
              padding: EdgeInsets.only(
                top: 20,
                left: 25,
                right: 25,
                bottom: MediaQuery.of(context).viewInsets.bottom + 20,
              ),
              decoration: BoxDecoration(
                color: isDark ? const Color(0xFF1E1E1E) : Colors.white,
                borderRadius: const BorderRadius.only(
                  topLeft: Radius.circular(30),
                  topRight: Radius.circular(30),
                ),
              ),
              child: SingleChildScrollView(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Center(
                      child: Container(
                        width: 50,
                        height: 5,
                        decoration: BoxDecoration(
                          color: Colors.grey.shade300,
                          borderRadius: BorderRadius.circular(10),
                        ),
                      ),
                    ),
                    const SizedBox(height: 20),
                    Text(
                      context.tr('security_title') ?? 'Bảo mật tài khoản',
                      style: const TextStyle(
                        fontSize: 22,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 10),
                    Text(
                      '${context.tr('connecting') ?? 'Đang kết nối:'} $googleEmail',
                      style: const TextStyle(
                        color: Colors.blue,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    const SizedBox(height: 5),
                    Text(
                      context.tr('google_pass_msg') ??
                          'Dù dùng Google, bạn vẫn cần thiết lập mật khẩu để quản lý quyền lợi an toàn hơn.',
                      style: TextStyle(
                        color: Colors.grey.shade500,
                        height: 1.4,
                      ),
                    ),
                    const SizedBox(height: 30),
                    TextField(
                      controller: newPassCtrl,
                      obscureText: obs1,
                      decoration: InputDecoration(
                        labelText:
                            context.tr('create_password') ?? 'Tạo mật khẩu',
                        prefixIcon: const Icon(Icons.lock),
                        suffixIcon: IconButton(
                          icon: Icon(
                            obs1 ? Icons.visibility_off : Icons.visibility,
                          ),
                          onPressed: () => setModalState(() => obs1 = !obs1),
                        ),
                        border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(15),
                        ),
                      ),
                    ),
                    const SizedBox(height: 20),
                    TextField(
                      controller: confirmPassCtrl,
                      obscureText: obs2,
                      decoration: InputDecoration(
                        labelText:
                            context.tr('confirm_password') ??
                            'Nhập lại mật khẩu',
                        prefixIcon: const Icon(Icons.lock_outline),
                        suffixIcon: IconButton(
                          icon: Icon(
                            obs2 ? Icons.visibility_off : Icons.visibility,
                          ),
                          onPressed: () => setModalState(() => obs2 = !obs2),
                        ),
                        border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(15),
                        ),
                      ),
                    ),
                    const SizedBox(height: 30),
                    SizedBox(
                      width: double.infinity,
                      height: 55,
                      child: ElevatedButton(
                        style: ElevatedButton.styleFrom(
                          backgroundColor: const Color(0xFF2A3A7C),
                          foregroundColor: Colors.white,
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(15),
                          ),
                        ),
                        onPressed: () async {
                          if (newPassCtrl.text.isEmpty ||
                              confirmPassCtrl.text.isEmpty) {
                            showFloatingToast(
                              context,
                              context.tr('error'),
                              context.tr('err_empty_field') ??
                                  'Vui lòng nhập đầy đủ thông tin!',
                              isError: true,
                            );
                            return;
                          }
                          if (newPassCtrl.text != confirmPassCtrl.text) {
                            showFloatingToast(
                              context,
                              context.tr('error'),
                              context.tr('err_pass_mismatch') ??
                                  'Hai mật khẩu không khớp nhau!',
                              isError: true,
                            );
                            return;
                          }

                          try {
                            await firebaseUser.updatePassword(
                              newPassCtrl.text.trim(),
                            );
                            if (ctx.mounted) {
                              Navigator.pop(ctx);
                              _saveAndNavigate(googleEmail);
                            }
                          } catch (e) {
                            showFloatingToast(
                              context,
                              context.tr('error'),
                              context.tr('err_generic') ??
                                  'Đã xảy ra lỗi, hãy thử lại!',
                              isError: true,
                            );
                          }
                        },
                        child: Text(
                          context.tr('btn_confirm_enter') ??
                              'Xác nhận & Vào nhà',
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }

  Widget _buildHeader(BuildContext context, bool isWhiteText) {
    bool isDark = Theme.of(context).brightness == Brightness.dark;
    Color color = isWhiteText
        ? Colors.white
        : (isDark ? const Color(0xFF6C8DF0) : const Color(0xFF2A3A7C));
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        Image.asset(
          'public/zenhome_logo_transparent.png',
          width: 75,
          height: 75,
          fit: BoxFit.contain,
          color: color,
        ),
        const SizedBox(height: 20),
        Text(
          _isEmailChecked
              ? (context.tr('welcome_back') ?? 'Chào mừng trở lại')
              : (context.tr('login') ?? 'Đăng Nhập'),
          style: TextStyle(
            fontSize: 30,
            fontWeight: FontWeight.w300,
            letterSpacing: 1.2,
            color: color,
          ),
        ),
        const SizedBox(height: 10),
        Text(
          _isEmailChecked
              ? _emailController.text
              : (context.tr('login_subtitle') ??
                    'Đồng bộ nhịp sống, kết nối tương lai.'),
          style: TextStyle(
            color: isWhiteText
                ? (isDark ? Colors.white70 : Colors.white.withOpacity(0.9))
                : color.withOpacity(0.7),
            fontStyle: FontStyle.italic,
          ),
        ),
      ],
    );
  }

  @override
