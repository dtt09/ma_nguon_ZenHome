PORT=5000
NODE_ENV=production
ADMIN_API_SECRET=your_admin_secret_key_here
CORS_ORIGIN=*

# Cấu hình tên miền công khai khi triển khai trên Hosting / VPS (ví dụ: https://zenhome.domain.com)
SERVER_BASE_URL=https://yourdomain.com

MQTT_URL=mqtts://your-mqtt-broker.hivemq.cloud:8883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
